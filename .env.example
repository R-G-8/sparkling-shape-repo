# Copy to .env for local development (never commit .env).
DEBUG=1
SECRET_KEY=change-me
# Leave unset locally to use SQLite; staging/production use Neon Postgres.
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1
# Grader accounts created by `python manage.py seed`
GRADER_ADMIN_EMAIL=admin@example.com
GRADER_ADMIN_PASSWORD=pick-a-unique-password
GRADER_MEMBER_EMAIL=member@example.com
GRADER_MEMBER_PASSWORD=pick-another-unique-password
# Optional: comma-separated course nicknames shown on the A/B page.
# Defaults to every member in docs/mgt656/team.yaml.
# TEAM_MEMBER_NICKNAMES=smoggy-sheep,gleaming-sheep,sleepy-toad,gentle-barracuda,zany-seahorse
